{
  "name": "solidjs-components-hr",
  "private": true,
  "version": "0.1.0",
  "description": "HR on Formbird (fieldtec-web): leave requests with balances, approval chains and minimum staffing, certifications with expiry, onboarding and the org chart, with SolidJS elements for leave balances, the skills matrix and the org chart, and a demo database. Builds on ../solidjs-components-shared, which provides the date range, approval chain, resource schedule (the leave calendar), checklist and stat tiles.",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "solidComponents": {
    "browserTest": "test/browser.mjs",
    "previewPort": 5183,
    "testBundles": [
      {
        "name": "hr-fixtures",
        "entry": "packages/fixtures/src/index.ts",
        "globalName": "HrFixtures"
      }
    ]
  },
  "scripts": {
    "build": "solid-components build --with-shared",
    "build:test-assets": "solid-components build --with-shared --test-assets",
    "typecheck": "solid-components typecheck",
    "test": "solid-components test",
    "test:browser": "solid-components build --with-shared --test-assets && solid-components browser-test",
    "check": "pnpm typecheck && pnpm test && pnpm test:browser",
    "dev": "solid-components dev",
    "deploy:fieldtec": "solid-components deploy",
    "docs": "solid-components build --with-shared && solid-components docs",
    "db:setup": "node setup-db.mjs",
    "demo:server": "node demo/server.mjs",
    "demo:e2e": "node demo/test/e2e.mjs"
  },
  "devDependencies": {
    "@solidjs-components/platform": "link:../solidjs-components-shared/packages/platform",
    "@solidjs-components/tools": "link:../solidjs-components-shared/packages/tools"
  }
}
